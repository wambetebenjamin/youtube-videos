{
  "name": "AI Video Studio",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-trixie",
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [3000, 53682],
  "portsAttributes": {
    "3000": {
      "label": "Remotion Studio",
      "onAutoForward": "notify"
    },
    "53682": {
      "label": "Google Drive OAuth (rclone)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash setup-video-studio.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "Anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
