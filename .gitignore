# Dependencies & build caches
node_modules/
dist/
build/
.remotion/

# Cloned third-party tool repositories (provisioned by setup-video-studio.sh)
tools/

# Duplicate skill trees emitted by some skill CLI versions
agent/

# Rendered video, graphic & ebook outputs (keep folder placeholders)
out/*
!out/.gitkeep
!out/videos/
!out/graphics/
!out/ebooks/
out/videos/*
!out/videos/.gitkeep
out/graphics/*
!out/graphics/.gitkeep
out/ebooks/*
!out/ebooks/.gitkeep

# Python virtualenv for the code-drawn film engines (skia / numpy / pillow)
.venv/
__pycache__/
*.pyc

# Agent skill directories installed by setup-video-studio.sh
.agents/
.claude/skills/
.cursor/
skills-lock.json

# Per-project build artifacts: placeholder/real narration, prepared textures, probe and chunk
# renders. These are regenerated by prep_assets.py / placeholder-voice.py / build_narration.py /
# render.py, and they are large — never commit them.
content/drafts/*/audio/
content/drafts/*/assets/
content/drafts/*/out/
content/drafts/*/__pycache__/

# OS & environment files
.DS_Store
*.log
.env
.env.*
!.env.example
