# Dependencies & build caches
node_modules/
dist/
build/
.remotion/
__pycache__/
*.pyc

# Rendered video & preview outputs (keep folder placeholder)
out/*
!out/.gitkeep

# Agent skill directories installed by setup-video-studio.sh
.agents/
.claude/skills/
.cursor/
skills-lock.json

# OS & environment files
.DS_Store
*.log
.env
.env.*
!.env.example

# Local processing/workspace staging (never commit large media or session data)
.cache/
google_drive/
public/edit/

# External reference repositories (local clones, not committed)
reference-repos/*
!reference-repos/README.md
