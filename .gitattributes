# Keep JSON diffs readable in review — these are the files that describe
# your edits, so they should always render as text.
*.json      text eol=lf diff
*.md        text eol=lf diff
*.mjs       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf

# Fonts and sample media are binary; never try to merge or diff them.
*.ttf       binary
*.otf       binary
*.mp4       binary
*.mov       binary
*.mp3       binary
*.wav       binary

# ---------------------------------------------------------------------
# Git LFS
#
# Media is gitignored by default, which is the right call for most people:
# footage is huge, changes constantly, and Git stores every version forever.
#
# If you *do* need the binaries versioned and shared — a team working off
# the same rushes, say — install Git LFS and uncomment the lines below,
# then remove the matching ignore rules from .gitignore.
#
#   git lfs install
#   git add .gitattributes
#
# Note GitHub's limits: 100 MB per file without LFS, and LFS storage and
# bandwidth are quota'd (1 GB free). A folder of 4K rushes will blow
# through that fast — see docs/media.md for the alternatives.
# ---------------------------------------------------------------------
# media/source/**  filter=lfs diff=lfs merge=lfs -text
# media/music/**   filter=lfs diff=lfs merge=lfs -text
# media/exports/** filter=lfs diff=lfs merge=lfs -text
