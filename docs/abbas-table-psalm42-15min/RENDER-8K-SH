#!/bin/bash
PYFF=$(python3 -c "import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())")
MUSIC=public/reels/music/1000853416.mp3
VOICE=out/youtube/abbas-voice-concat.mp3
THUMB=docs/abbas-table-psalm42-15min/thumbnail-8k.jpg
OUT=out/youtube/abbas-table-psalm42-15min-8K.mp4
# 15:30 = 930s — voice 5:24 in center, music fills full duration with gentle ducking
$PYFF -y -loop 1 -i "$THUMB" -i "$VOICE" -i "$MUSIC" -t 930 \
 -filter_complex "[1:a]adelay=2000|2000[vo];[2:a]volume=0.18[mu];[vo][mu]amix=inputs=2:duration=longest[a]" \
 -vf "scale=7680:4320:force_original_aspect_ratio=decrease,pad=7680:4320:(ow-iw)/2:(oh-ih)/2:color=black,format=yuv420p" \
 -c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -r 30 -c:a aac -b:a 192k -shortest "$OUT"
echo "Built $OUT — upload to YouTube as 8K"
